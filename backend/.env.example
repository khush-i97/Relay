# Required for local Supabase. Copy the values printed by `npx supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Required application settings.
APP_ORIGIN=http://localhost:3000
DEMO_MODE=true

# Adventure provider: deterministic, zoowork, or novita.
ADVENTURE_PROVIDER=deterministic

# ZooWork Instinct: use the paid ZooData key OR the free-preview ZooWork key.
ZOODATA_API_KEY=
ZOOWORK_API_KEY=
ZOOWORK_MODEL=instinct

# Novita planner (required only when ADVENTURE_PROVIDER=novita).
NOVITA_API_KEY=
NOVITA_MODEL=

# Optional semantic ranking. The named Moss index must already exist.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX_NAME=bitequest-restaurants

# Optional live-web enrichment; synthetic fixtures are never submitted.
TAVILY_API_KEY=
